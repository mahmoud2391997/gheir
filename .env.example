# MongoDB Atlas connection string.
MONGODB_URI="mongodb+srv://..."

# Secret used to sign admin session tokens.
# Production (Vercel or NODE_ENV=production) refuses to boot if this is missing,
# shorter than 32 characters, or still a known placeholder (including
# "replace-with-a-long-random-secret" and the old Nexus dev secrets).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
# Single admin login. Local dev falls back to admin@example.com and a baked-in
# development password hash. Production refuses that fallback.
# Generate a hash with: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="$2b$12$replace-with-bcrypt-hash"

# Optional: API key for the in-store POS to use shared inventory endpoints.
# POS must send header: x-pos-key: <POS_API_KEY>
# If set in production, this exact placeholder is refused at boot. Unset it to disable POS.
POS_API_KEY="replace-with-a-long-random-secret"

# Comma-separated list of allowed CORS origins for POS web app (for browser-based POS).
# Example: POS_ALLOWED_ORIGINS="https://gheir-pos.vercel.app,http://localhost:3000"
POS_ALLOWED_ORIGINS="*"
