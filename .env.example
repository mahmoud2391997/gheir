# MongoDB Atlas connection string. Server-only. Never prefix this with NEXT_PUBLIC_.
MONGODB_URI="mongodb+srv://..."

# Public site URL used for canonical links, Open Graph, and the sitemap.
NEXT_PUBLIC_APP_URL="https://gheir.vercel.app"

# Secret used to sign admin and POS session tokens.
# Production refuses to boot if this is missing, shorter than 32 characters,
# or still a known placeholder.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Single admin login. Local dev falls back to admin@example.com and a baked-in
# development password hash. Production refuses that fallback.
# Generate a hash with: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="$2b$12$replace-with-bcrypt-hash"

# Server-side key for the separate POS. The POS should exchange it once at
# POST /api/pos/auth and then send Authorization: Bearer <token>.
# Existing POS servers may still send x-pos-key. Do not put this value in browser code.
# If set in production, a placeholder is refused at boot. Unset it to disable POS.
POS_API_KEY="replace-with-a-long-random-secret"

# Comma-separated browser origins allowed to call /api/pos. Production refuses "*".
# Local development also allows http://localhost and http://127.0.0.1.
POS_ALLOWED_ORIGINS="http://localhost:3000"
