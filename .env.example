# MongoDB Atlas connection string.
MONGODB_URI="mongodb+srv://..."

# Secret used to sign admin session tokens.
JWT_SECRET="replace-with-a-long-random-secret"
# Single admin login. If omitted, development defaults are admin@example.com / admin123.
# Generate a custom hash with: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="$2b$12$replace-with-bcrypt-hash"

# Optional: API key for the in-store POS to use shared inventory endpoints.
# POS must send header: x-pos-key: <POS_API_KEY>
POS_API_KEY="replace-with-a-long-random-secret"
